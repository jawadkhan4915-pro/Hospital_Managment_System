# ============================================================
# Enterprise Hospital Management System (HMS)
# Environment Variables Guide for Local, Render & Vercel
# ============================================================

# ------------------------------------------------------------
# 1. RENDER (BACKEND WEB SERVICE) ENVIRONMENT VARIABLES
# Set these in Render Dashboard -> Web Service -> Environment
# ------------------------------------------------------------

NODE_ENV=production
PORT=10000

# MongoDB Connection String (Atlas Cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms?retryWrites=true&w=majority

# Strong 64-character JWT secret key for token signing
JWT_SECRET=your_production_jwt_secret_key_min_32_chars_long

# Allowed CORS Origin (Vercel Frontend URL - no trailing slash)
FRONTEND_URL=https://your-app-name.vercel.app


# ------------------------------------------------------------
# 2. VERCEL (FRONTEND WEB APP) ENVIRONMENT VARIABLES
# Set these in Vercel Project Settings -> Environment Variables
# ------------------------------------------------------------

# Production Backend API URL (Render Backend URL - no trailing slash)
VITE_API_URL=https://your-backend-name.onrender.com


# ------------------------------------------------------------
# 3. LOCAL DEVELOPMENT (.env)
# ------------------------------------------------------------

# PORT=5000
# NODE_ENV=development
# MONGO_URI=mongodb://127.0.0.1:27017/hms
# JWT_SECRET=enterprise_hms_jwt_secret_key_2026_secure

